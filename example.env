# ==============================================================================
# RyuNET Demonware Server (CTR Nitro-Fueled PS4/PC) - Configuration Example
# Basado en la investigacion y codigo de Nextendo Network
# ==============================================================================
# Copia este archivo a ".env" y edita los valores segun tu entorno.
# NUNCA subas tu archivo ".env" real con contraseñas a repositorios publicos.

# --- Red y Puertos ---
# Direccion IPv4 publica o local anunciada a los clientes en respuestas NAT/STUN.
# En local usar 127.0.0.1, en VPS tu IP publica o dominio (ej. 203.0.113.1 o tu-dominio.xyz).
RYUNET_HOST=127.0.0.1
NEXTENDO_HOST=127.0.0.1

# Puerto HTTP claro para emuladores y shadPS4 host_overrides.json (evita problemas de TLS).
# Si es 0 se desactiva. Recomendado para pruebas y PC: 8080.
DEMONWARE_HTTP_PORT=8080

# Puerto HTTPS oficial de Demonware Auth.
AUTH_PORT=8460

# Puertos del Lobby Demonware (TCP). CTR usa 3074 principalmente.
LOBBY_PORTS=3074,3075,3076,3077,3078,3079,3080

# Puerto NAT / STUN discovery (UDP). El juego usa 3074.
NAT_PORT=3074

# Certificados SSL para HTTPS (opcional si usas DEMONWARE_HTTP_PORT en localhost)
CERT_FILE=cert.pem
KEY_FILE=key.pem

# Soporte para PROXY Protocol v1 (por si esta detras de un router proxy / HAProxy)
RYUNET_PROXY_PROTOCOL=0

# --- Modo CTR / PS4 ---
# 1 = Acepta cualquier NPID/usuario y calcula un PID estable (ideal para shadPS4 / PC)
PS4_MODE=1

# Clave privada RSA para firmar tokens de autenticacion CTR (opcional)
CTR_AUTH_SIGNING_KEY=ctr_ps4.key

# Wumpa Coins con las que se crea un monedero nuevo (solo la primera vez que entra
# un jugador; los monederos existentes no cambian)
CTR_START_BALANCE=10000

# --- Integracion de Cuentas (Opcional) ---
# Requiere validar cuenta contra backend (0 = permite a cualquiera jugar sin login previo)
RYUNET_REQUIRE_ACCOUNT=0
RYUNET_REQUIRE_SIGNED_TOKEN=0
RYUNET_ACCOUNT_URL=http://127.0.0.1:8080
RYUNET_INTERNAL_KEY=change-me
RYUNET_SECRET=change-me

# --- Monitoreo y Dashboard ---
DASH_PORT=8093
DASH_TOKEN=change-me

# --- Sesiones y Logs ---
RYUNET_SESSIONS=sessions
RYUNET_DUMPS=off
RYUNET_VERBOSE=0
# debug = registra cada tarea/paquete (local). info = solo arranque, errores,
# rechazos, compras y entrada/salida de jugadores (recomendado en produccion).
RYUNET_LOG_LEVEL=debug
