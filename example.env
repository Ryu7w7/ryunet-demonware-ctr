# ==============================================================================
# RyuNET Demonware Server (CTR Nitro-Fueled PS4/PC) - Configuration Example
# Basado en la investigacion y codigo de Nextendo Network
# ==============================================================================
# Copia este archivo a ".env" y edita los valores segun tu entorno.
# NUNCA subas tu archivo ".env" real con contraseñas a repositorios publicos.

# --- Red y Puertos ---
# Direccion IPv4 publica o local anunciada a los clientes en respuestas NAT/STUN.
# En local usar 127.0.0.1, en VPS tu IP publica o dominio (ej. 203.0.113.1 o tu-dominio.xyz).
# 0.0.0.0 (servidor en casa con amigos por Radmin/ZeroTier/LAN): a cada jugador se le anuncia
# la IP de este PC por la que llega. No sirve para el relay (CTR_RELAY_*), que necesita una IP fija.
RYUNET_HOST=127.0.0.1
NEXTENDO_HOST=127.0.0.1

# Puerto HTTP claro para emuladores y shadPS4 host_overrides.json (evita problemas de TLS).
# Si es 0 se desactiva. Recomendado para pruebas y PC: 8080.
DEMONWARE_HTTP_PORT=8080

# Puerto HTTPS oficial de Demonware Auth.
AUTH_PORT=8460

# Puertos del Lobby Demonware (TCP). CTR usa 3074 principalmente.
LOBBY_PORTS=3074,3075,3076,3077,3078,3079,3080

# Puerto NAT / STUN discovery (UDP). El juego usa 3074.
NAT_PORT=3074

# Certificados SSL para HTTPS (opcional si usas DEMONWARE_HTTP_PORT en localhost)
CERT_FILE=cert.pem
KEY_FILE=key.pem

# Soporte para PROXY Protocol v1 (por si esta detras de un router proxy / HAProxy)
RYUNET_PROXY_PROTOCOL=0

# --- Modo CTR / PS4 ---
# 1 = Acepta cualquier NPID/usuario y calcula un PID estable (ideal para shadPS4 / PC)
PS4_MODE=1

# Clave privada RSA para firmar tokens de autenticacion CTR (opcional)
CTR_AUTH_SIGNING_KEY=ctr_ps4.key

# Wumpa Coins con las que se crea un monedero nuevo (solo la primera vez que entra
# un jugador; los monederos existentes no cambian)
CTR_START_BALANCE=10000

# --- Integracion de Cuentas (Opcional) ---
# Requiere validar cuenta contra backend (0 = permite a cualquiera jugar sin login previo)
RYUNET_REQUIRE_ACCOUNT=0
RYUNET_REQUIRE_SIGNED_TOKEN=0
RYUNET_ACCOUNT_URL=http://127.0.0.1:8080
RYUNET_INTERNAL_KEY=change-me
RYUNET_SECRET=change-me

# --- Monitoreo y Dashboard ---
DASH_PORT=8093
DASH_TOKEN=change-me

# --- Sesiones y Logs ---
RYUNET_SESSIONS=sessions
RYUNET_DUMPS=off
RYUNET_VERBOSE=0
# debug = registra cada tarea/paquete (local). info = solo arranque, errores,
# rechazos, compras y entrada/salida de jugadores (recomendado en produccion).
RYUNET_LOG_LEVEL=debug

# Objetos del Pit Stop (personajes, skins, karts...) que el juego ve como tuyos en online:
#   server = cada jugador elige en el launcher (pestana Online): progresion en el servidor
#            (lo comprado, ligado al apodo; por defecto) o "de mi partida guardada" (100%)
#   all    = todo el catalogo para todos (no depende de la partida guardada)
#   save   = todos con los objetos de su partida guardada, como antes del arreglo de las
#            cajas; el Pit Stop no vende nada
CTR_INVENTORY=server

# Apodos (PS4/PC): el primer jugador que usa un apodo con su clave de instalacion se lo
# queda; nadie mas puede entrar con el, y RyuPC/RyuNET/Player... se rechazan. Los registros
# van en RYUNET_NICKS (por defecto wallets/nick-claims.json). 0 = desactivar.
RYUNET_NICK_CLAIMS=1
# RYUNET_NICKS=wallets/nick-claims.json
# 1 = rechazar a los clientes sin clave (launcher antiguo) aunque su apodo este libre.
# Activalo cuando casi todos hayan actualizado: desde ese momento ningun apodo se comparte.
RYUNET_NICK_REQUIRE_KEY=0
# Apodos sin vincular a Discord que nadie usa en estos dias quedan libres otra vez (0 = nunca).
RYUNET_NICK_EXPIRE_DAYS=60
# Liberar un apodo a mano (jugador que perdio su instalacion y su Discord):
#   http://<servidor>:<DASH_PORT>/api/nick/release?key=<DASH_TOKEN>&name=<apodo>

# --- Cuentas de Discord (apodo vinculado, recuperable desde cualquier PC) ---
# Discord Developer Portal > tu aplicacion > OAuth2: copia el Client Secret aqui y anade estas
# Redirects (las usa el launcher): http://127.0.0.1:53134/discord, http://127.0.0.1:53135/discord
# y http://127.0.0.1:53136/discord. Sin secreto, la vinculacion queda desactivada.
# El secreto solo va en el servidor: nunca en el launcher ni en un repositorio.
DISCORD_CLIENT_SECRET=
# DISCORD_CLIENT_ID=1560408801704943708
# RYUNET_DISCORD_REDIRECTS=http://127.0.0.1:53134/discord,http://127.0.0.1:53135/discord,http://127.0.0.1:53136/discord

# Grupos en partidas publicas: cada miembro del grupo recibe el mismo evento de
# unirse/fusionar sala que su lider. Activado por defecto; 0 para desactivarlo.
CTR_PARTY_NOTIFY_MEMBERS=1
